generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users{
  id        Int      @id @default(autoincrement())
  name      String
  lastName  String
  userName  String @unique
  email     String @unique
  createdAt DateTime @default(now())
  password  String

  chatHistories ChatHistory[]
}

model ChatHistory {
  id        Int      @id @default(autoincrement())
  userText  String
  aiResponse String
  createdAt DateTime @default(now())
  userId Int
  user   Users @relation(fields: [userId], references: [id])
}

model KnowledgeBase {
  id      Int    @id @default(autoincrement())
  topic   String
  content String
}

model ImageAnalysis {
  id          Int      @id @default(autoincrement())
  imageHash   String   @unique
  objectsData String   
  createdAt   DateTime @default(now())
}